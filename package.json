{
  "name": "cloud-tunnel",
  "version": "0.1.0",
  "description": "Desktop app to manage and activate Cloudflare tunnels on demand",
  "main": "./out/main/index.js",
  "author": {
    "name": "Belizário Ribeiro",
    "email": "belizariogr@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bun run fetch:cloudflared && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test",
    "fetch:cloudflared": "bun run scripts/fetch-cloudflared.ts",
    "generate:icons": "bun run scripts/generate-icons.ts",
    "setup:oauth": "bun run scripts/setup-oauth.ts",
    "oauth:scopes": "bun run scripts/fetch-oauth-scopes.ts",
    "prebuild:app": "bun run fetch:cloudflared && bun run generate:icons",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:win": "bun run build && electron-builder --win",
    "dist:mac": "bun run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "cloudflaredVersion": "2025.2.1"
}
